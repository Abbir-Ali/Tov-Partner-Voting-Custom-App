// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum BoardStatus {
  DRAFT
  SHARED
  VOTED
}

enum Verdict {
  LOVE
  MAYBE
  PASS
}

model Board {
  id                String      @id @default(cuid())
  shop              String
  shareToken        String      @unique
  ownerToken        String      @unique   // lets the shopper view results; never sent to the partner
  creatorKey        String               // sha256 hash of shop + customer id or lowercased email; never raw
  customerId        String?
  ownerFirstName    String?
  ownerEmail        String?
  partnerFirstName  String?
  name              String
  note              String?
  status            BoardStatus @default(DRAFT)
  sharedAt          DateTime?
  votingCompletedAt DateTime?
  notifiedAt        DateTime?
  expiresAt         DateTime
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items             BoardItem[]

  @@index([shop, customerId])
  @@index([expiresAt])
  @@index([shop, creatorKey, createdAt])
  @@map("boards")
}

model BoardItem {
  id        String   @id @default(cuid())
  boardId   String
  productId String
  variantId String
  position  Int
  createdAt DateTime @default(now())

  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  votes     Vote[]

  @@unique([boardId, variantId])
  @@index([boardId])
  @@map("board_items")
}

model Vote {
  id          String    @id @default(cuid())
  boardItemId String
  verdict     Verdict
  note        String?
  voterName   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  boardItem   BoardItem @relation(fields: [boardItemId], references: [id], onDelete: Cascade)

  @@unique([boardItemId])
  @@map("votes")
}

model ShopSettings {
  id                   String   @id @default(cuid())
  shop                 String   @unique
  enabled              Boolean  @default(false)
  abTestEnabled        Boolean  @default(false)
  abTestPercent        Int      @default(50)
  boardExpiryDays      Int      @default(30)
  maxItemsPerBoard     Int      @default(12)
  maxSharesPerDay      Int      @default(10)
  notificationsEnabled Boolean  @default(true)
  excludeTag           String   @default("pvb-exclude")
  copy                 Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("shop_settings")
}

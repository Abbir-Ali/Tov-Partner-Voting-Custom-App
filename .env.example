# Postgres connection for Prisma.
# Local dev: postgresql://voting_board:<password>@localhost:5432/voting_board_dev?schema=public

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# 32-byte key for encrypting Klaviyo API keys at rest (base64).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# Salt for hashing visitor IDs in analytics events (server secret).
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
APP_EVENT_SALT=""

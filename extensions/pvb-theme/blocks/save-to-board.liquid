{% comment %}
  Save to Board button — app block for product pages.
  JS loaded via schema; no inline script.
{% endcomment %}

{% assign config_raw = app.metafields.pvb.config.value %}
{% if config_raw != blank and config_raw.enabled %}
  {% comment %} Skip gift cards and excluded tag {% endcomment %}
  {% assign is_excluded = false %}
  {% if product.gift_card? %}
    {% assign is_excluded = true %}
  {% elsif config_raw.excludeTag != blank %}
    {% assign exclude_tag_lower = config_raw.excludeTag | downcase %}
    {% for tag in product.tags %}
      {% assign tag_lower = tag | downcase %}
      {% if tag_lower == exclude_tag_lower %}
        {% assign is_excluded = true %}
        {% break %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% unless is_excluded %}
  <div
    class="pvb-save-button"
    data-pvb-save-button
    data-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle | escape }}"
    data-max-items="{{ config_raw.maxItemsPerBoard }}"
    data-style="{{ block.settings.style }}"
    data-label-save="{{ block.settings.label_save | escape }}"
    data-label-saved="{{ block.settings.label_saved | escape }}"
    {% if block.settings.helper_save != blank %}
    data-helper-save="{{ block.settings.helper_save | escape }}"
    {% endif %}
    {% if block.settings.helper_saved != blank %}
    data-helper-saved="{{ block.settings.helper_saved | escape }}"
    {% endif %}
    data-label-full="{{ block.settings.label_full | escape }}"
    data-view-label="{{ block.settings.view_label | escape }}"
    style="--pvb-btn-max-width: {{ block.settings.max_width }}px;"
  >
    <button
      type="button"
      class="pvb-save-pill"
      aria-pressed="false"
      aria-label="{{ block.settings.label_save | escape }}"
    >
      <span class="pvb-save-icon">
        <svg class="pvb-save-heart" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </span>
      <span class="pvb-save-text">
        <span class="pvb-save-label">{{ block.settings.label_save | escape }}</span>
        {% if block.settings.helper_save != blank %}
        <span class="pvb-save-helper">{{ block.settings.helper_save | escape }}</span>
        {% endif %}
      </span>
      <button type="button" class="pvb-view-chip" hidden aria-label="View your board">
        <span class="pvb-view-label">{{ block.settings.view_label | escape }}</span>
        <span class="pvb-view-count">(0)</span>
      </button>
    </button>
    <p class="pvb-full-msg">{{ block.settings.label_full | escape }}</p>
  </div>
  {% endunless %}
{% endif %}

{% schema %}
{
  "name": "Save to Board",
  "target": "section",
  "javascript": "pvb-button.js",
  "stylesheet": "pvb-board.css",
  "settings": [
    {
      "type": "header",
      "content": "Button size"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width (px)",
      "min": 280,
      "max": 600,
      "step": 10,
      "default": 440
    },
    {
      "type": "header",
      "content": "Unsaved state"
    },
    {
      "type": "text",
      "id": "label_save",
      "label": "Save label",
      "default": "Save to Board"
    },
    {
      "type": "text",
      "id": "helper_save",
      "label": "Save helper text"
    },
    {
      "type": "header",
      "content": "Saved state"
    },
    {
      "type": "text",
      "id": "label_saved",
      "label": "Saved label",
      "default": "Saved to Board"
    },
    {
      "type": "text",
      "id": "helper_saved",
      "label": "Saved helper text"
    },
    {
      "type": "text",
      "id": "view_label",
      "label": "View chip label",
      "default": "View"
    },
    {
      "type": "header",
      "content": "Full state"
    },
    {
      "type": "text",
      "id": "label_full",
      "label": "Board full message",
      "default": "Your board is full. Remove a piece to add another."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "icon-text", "label": "Full button" },
        { "value": "icon-only", "label": "Icon only" }
      ],
      "default": "icon-text"
    }
  ]
}
{% endschema %}
